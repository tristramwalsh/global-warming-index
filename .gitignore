# FaIR Climate Model code, downloaded on first run (see models/__init__.py).
# The rest of models/FaIR_V2/ (SOURCE.md, CMIP6 parameters) is tracked.
/models/FaIR_V2/FaIRv2_0_0_alpha1/

# recipes for your own development runs
/recipes/dev*.sh

# outputs, each in a folder per output tag: logs (logs/slurm/<tag>/,
# logs/direct/<tag>/), results (results/<tag>/) and plots (plots/<tag>/)
/logs/
/results/
/plots/
# outputs from before they were grouped (logs_slurm_<tag>/, results_<tag>/,
# plots_<tag>/, ...), and from before the rename to logs_slurm
/logs_*/
/results_*/
/plots_*/
/slurm_logs*/
/outputs/

# VS Code
.vscode

# Byte-compiled / optimized / DLL files
__pycache__/